# Dark diagram palette — warm neutrals mirroring src/styles/tokens.css.
# N7 = figure background (--color-surface). Imported via base.d2 / base-dark.d2 only.

vars: {
  d2-config: {
    theme-overrides: {
      N1: "#ebe7e0"
      N2: "#d6d1c8"
      N3: "#a8a196"
      N4: "#7d776d"
      N5: "#57524b"
      N6: "#35322d"
      N7: "#1f1d1a"
      B1: "#d6d1c8"
      B2: "#a8a196"
      B3: "#7d776d"
      B4: "#2e2b27"
      B5: "#282622"
      B6: "#23211e"
      AA2: "#a8a196"
      AA4: "#2e2b27"
      AA5: "#282622"
      AB4: "#2e2b27"
      AB5: "#282622"
    }
  }
}
