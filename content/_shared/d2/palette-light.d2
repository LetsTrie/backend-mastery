# Light diagram palette — warm neutrals mirroring src/styles/tokens.css.
# N7 = figure background (--color-surface). Imported via base.d2 / base-dark.d2 only.

vars: {
  d2-config: {
    theme-overrides: {
      N1: "#1f1d1a"
      N2: "#3a3631"
      N3: "#5f5a52"
      N4: "#8a847a"
      N5: "#b8b2a7"
      N6: "#e0dbd1"
      N7: "#f3f1ec"
      B1: "#3a3631"
      B2: "#5f5a52"
      B3: "#8a847a"
      B4: "#e8e4db"
      B5: "#eeebe4"
      B6: "#f7f5f1"
      AA2: "#5f5a52"
      AA4: "#e8e4db"
      AA5: "#eeebe4"
      AB4: "#e8e4db"
      AB5: "#eeebe4"
    }
  }
}
