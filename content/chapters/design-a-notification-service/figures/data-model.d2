...@../../../_shared/d2/base

grid-columns: 3
grid-gap: 48

notifications_by_user: {
  shape: sql_table
  user_id: uuid {constraint: primary_key}
  created_at: timestamp {constraint: primary_key}
  notification_id: text {constraint: primary_key}
  category: text
  template_id: text
  template_version: int
  params: blob
  status: text
}

deliveries: {
  shape: sql_table
  notification_id: text {constraint: primary_key}
  channel: text {constraint: primary_key}
  state: text
  attempts: int
  updated_at: timestamp
}

send_log: {
  shape: sql_table
  notification_id: text {constraint: primary_key}
  target: text {constraint: primary_key}
  state: text
  attempt_id: uuid
  lease_until: timestamp
  epoch: int
}

inbox_by_user: {
  shape: sql_table
  user_id: uuid {constraint: primary_key}
  created_at: timestamp {constraint: primary_key}
  notification_id: text {constraint: primary_key}
  title: text
  body: text
  read_at: timestamp
}

devices: {
  shape: sql_table
  user_id: uuid {constraint: primary_key}
  device_id: uuid {constraint: primary_key}
  platform: text
  token: text
  last_seen: timestamp
}

device_by_token: {
  shape: sql_table
  token_hash: blob {constraint: primary_key}
  user_id: uuid
  device_id: uuid
}
