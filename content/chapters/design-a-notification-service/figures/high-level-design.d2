...@../../../_shared/d2/base

direction: down

producers: Producer services {class: service}
fanout: Campaign fan-out {class: service}
api: Notification API {class: service}
idem: "Idempotency\nstore" {class: cache}

requests: Request topics {
  class: boundary
  direction: right
  high: high {class: queue}
  normal: normal {class: queue}
  batch: "campaign\npages" {class: queue}
}

processors: "Processor pools\n(one per request topic)" {class: service}

lookups: Lookups {
  class: boundary
  direction: right
  prefs: Preferences {class: datastore}
  devices: Device registry {class: datastore}
  templates: Templates {class: datastore}
}

scheduler: Scheduler {class: job}
channels: "Channel topics\n(push, email, SMS, in-app ×\nhigh, normal, bulk lanes)" {class: queue}
workers: Channel workers {class: service}
providers: "Providers (APNs, FCM, email, SMS)" {class: external}
inbox: Inbox store {class: datastore}
tracking: Tracking service {class: service}
status: Status store {class: datastore}

producers -> api: "① POST /v1/notifications"
api -> idem: "② record key"
api -> requests.high: "③ append by priority, then 202" {class: async}
api -> requests.normal {class: async}
fanout -> requests.batch: "pages" {class: async}
requests -> processors: "④ consume" {class: async}
processors -> lookups: "⑤ look up, decide, render"
processors -> scheduler: "hold" {class: async}
scheduler -> channels: "release" {class: async}
processors -> channels: "⑥ one message per channel" {class: async}
channels -> workers {class: async}
workers -> providers: "⑦ send" {class: focus}
workers -> inbox: "⑧ write"
providers -> tracking: "⑨ delivery webhooks" {class: async}
tracking -> status
workers -> status: "sent / failed"
