...@../../../_shared/d2/base

direction: down

in: Request topics {class: queue}

processor: Notification processor {
  class: boundary
  direction: down
  dedup: "1. Deduplicate" {class: service}
  prefs: "2. Preferences and opt-outs" {class: service}
  aggregate: "3. Aggregate" {class: service}
  select: "4. Select channels" {class: service}
  caps: "5. Frequency caps" {class: service}
  render: "6. Render" {class: service}
  route: "7. Send now or hold" {class: service}

  dedup -> prefs -> aggregate -> select -> caps -> render -> route
}

out: Channel topics {class: queue}
suppressed: Suppression log {class: datastore}
scheduler: Scheduler {class: job}

in -> processor.dedup {class: async}
processor.route -> out: "now" {class: async}
processor.route -> scheduler: "quiet hours, send-at" {class: async}
processor.dedup -> suppressed: "duplicate" {class: async}
processor.prefs -> suppressed: "opted out" {class: async}
processor.caps -> suppressed: "over cap" {class: async}
processor.aggregate -> scheduler: "digest window" {class: [async; focus]}
