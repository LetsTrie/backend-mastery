...@../../../_shared/d2/base

direction: down

producers: Producer services {class: service}
directory: "User directory\n(home, epoch, lease)" {class: datastore}

pair: Paired regions {
  class: boundary
  grid-columns: 2

  a: "Region A (lease expired)" {
    class: boundary
    direction: down
    topics: Request topics {class: queue}
    workers: "Workers\n(stopped)" {class: service}
    state: "Send log, caps,\nschedule, inbox" {class: datastore}
    topics -> workers
    workers -> state
  }

  b: "Region B (new owner)" {
    class: boundary
    direction: down
    api: Notification API {class: service}
    topics: Mirrored topics {class: queue}
    workers: Processors and workers {class: service}
    state: Replicated state {class: datastore}
    api -> topics -> workers
    workers -> state
  }

  a.topics -> b.topics: "async mirror" {class: async}
  a.state -> b.state: "async replication" {class: async}
}

providers: Providers {class: external}

directory -> pair.b.workers: "① lease + epoch 8" {class: focus}
producers -> pair.b.api: "② route to new home"
pair.b.workers -> providers: "③ send while lease valid"
pair.a.workers -> providers: "blocked: lease expired" {class: failure}
