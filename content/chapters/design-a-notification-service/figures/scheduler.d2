...@../../../_shared/d2/base

direction: down

writers: "" {
  class: boundary
  direction: right
  style.stroke: transparent
  processor: Notification processor {class: service}
  campaigns: Campaign service {class: service}
}

due: "Due-time table\n(partitioned by minute)" {class: datastore}
sweeper: Sweeper {class: job}
lanes: Priority lanes {class: queue}
suppressed: Suppression log {class: datastore}

writers.processor -> due: "① write (due_minute, id)"
writers.campaigns -> due: "① write"
due -> sweeper: "② read current minute"
sweeper -> due: "③ claim: pending → released" {class: focus}
sweeper -> lanes: "④ publish" {class: async}
sweeper -> suppressed: "TTL already passed → expired" {class: failure}
