...@../../../_shared/d2/base

direction: down

processor: Notification processor {class: service}
campaigns: Campaign service {class: service}

due: "Due-time table\n((due_minute, shard), id)" {class: datastore}
sweeper: "Sweepers\n(one lease per minute × shard)" {class: job}
target: "Row's target topic\n(channel lane, request topic,\nor fan-out job)" {class: queue}
suppressed: Suppression log {class: datastore}

processor -> due: "① write, jittered due time"
campaigns -> due: "① one row per IANA time zone"
due -> sweeper: "② read own shard, claim with lease" {class: focus}
sweeper -> target: "③ publish" {class: async}
sweeper -> due: "④ mark released"
sweeper -> suppressed: "TTL passed → expired" {class: failure}
