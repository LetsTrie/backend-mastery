    "@tailwindcss/turbopack": "^4.3.3",
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/mdx": "2.0.14",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "prettier": "3.9.10",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.15",
    "typescript": "^5.9.3",
    "vitest": "5.0.5"
  }
